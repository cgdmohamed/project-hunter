# ---- Core -------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ---- Scheduling -------------------------------------------------------
SCAN_INTERVAL_MINUTES=30
SCAN_ON_STARTUP=false
AUTO_SCAN_ENABLED=false

# ---- Qualification thresholds -----------------------------------------
MIN_PROJECT_BUDGET_USD=100
MIN_PROJECT_SCORE=75

# ---- Mostaql scraper --------------------------------------------------
MOSTAQL_BASE_URL=https://mostaql.com
SCRAPER_ENABLED=true
SCRAPER_REQUEST_TIMEOUT_MS=20000
SCRAPER_REQUEST_DELAY_MS=5000
SCRAPER_MAX_CONCURRENCY=1
SCRAPER_MAX_LISTING_PAGES=1
SCRAPER_RETRY_MAX=3
SCRAPER_STRUCTURE_MISMATCH_ALERT_THRESHOLD=3
# Re-fetch a project detail page at most this often (hours) to detect changes.
# 0 = always refresh. Higher = fewer requests but slower change detection.
SCRAPER_DETAIL_REFRESH_HOURS=24
# Optional UA override. Leave commented for the built-in polite default.
# MOSTAQL_USER_AGENT=

# Optional JSON overrides for CSS selectors (merged over defaults).
# MOSTAQL_SELECTORS={"listing":{"rows":"a[href*=\"/project/\"]"}}

# Enabled only when access requires JS rendering AND it is permitted.
# Requires "playwright" + browser installed (see README).
PLAYWRIGHT_ENABLED=false

# ---- Storage (SQLite) -------------------------------------------------
DATA_DIR=/app/data
DATABASE_PATH=/app/data/project-hunter.sqlite

# ---- OpenAI -----------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional base URL for an OpenAI-compatible gateway/proxy.
# OPENAI_BASE_URL=
OPENAI_REQUEST_TIMEOUT_MS=60000
OPENAI_MAX_TOKENS=4000
# Estimated USD cost per 1M tokens (configurable, defaults shown).
# These are intentionally not hardcoded assumptions beyond a starting point.
OPENAI_INPUT_PRICE_PER_1M=0.15
OPENAI_OUTPUT_PRICE_PER_1M=0.60
# How many projects run through the full AI pipeline per scan (bound spend).
OPENAI_MAX_ANALYSES_PER_SCAN=10

# Optional JSON map currency-code -> USD exchange rate.
# BUDGET_USD_RATES={"SAR":0.2667,"AED":0.2723,"EGP":0.0204,"JOD":1.4102,"KWD":3.2641,"QAR":0.2747,"BHD":2.6525,"OMR":2.5980,"USD":1,"EUR":1.09,"GBP":1.27}

# ---- Telegram ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT_MS=20000

# ---- Admin / internal API ---------------------------------------------
ADMIN_API_KEY=
# Minutes to suppress duplicate technical alerts for the same issue.
ALERT_DEDUP_MINUTES=60
# Optional: use RSS.app JSON feed instead of direct Mostaql scraper
RSS_FEED_URL=https://rss.app/feeds/v1.1/InYp3JgP8mCnAqYq.json
